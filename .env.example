# Feature-Flags zur Steuerung der UI-Sichtbarkeit.
#
# Diese Datei ist die Vorlage. Kopiere sie zu ".env" und passe die Werte an:
#   cp .env.example .env
#
# Die Werte werden über die .NET-Konvention "__" als Trenner auf die
# "Features"-Konfigurationssektion abgebildet (Features:MonetizationEnabled usw.).
# Reale Umgebungsvariablen (z. B. aus Docker Compose) haben Vorrang vor dieser Datei.

# Monetarisierung im UI sichtbar? (Mitgliedschaft, Spenden, Premium-CTAs)
#   true  = sichtbar (Standard)
#   false = im UI ausgeblendet; Seiten bleiben per Direkt-URL erreichbar
Features__MonetizationEnabled=true

# Login/Registrierung im UI sichtbar?
#   true  = sichtbar (Standard)
#   false = Anmelden-/Registrieren-Links ausgeblendet;
#           /Account/Login bleibt per Direkt-URL erreichbar
Features__LoginEnabled=true
