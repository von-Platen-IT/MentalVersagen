# Feature-Flags zur Steuerung der UI-Sichtbarkeit.
#
# Diese Datei ist die Vorlage. Kopiere sie zu ".env" und passe die Werte an:
#   cp .env.example .env
#
# Die Werte werden über die .NET-Konvention "__" als Trenner auf die
# "Features"-Konfigurationssektion abgebildet (Features:MonetizationEnabled usw.).
# Reale Umgebungsvariablen (z. B. aus Docker Compose) haben Vorrang vor dieser Datei.

# Monetarisierung im UI sichtbar? (Mitgliedschaft, Spenden, Premium-CTAs)
#   true  = sichtbar (Standard)
#   false = im UI ausgeblendet; Seiten bleiben per Direkt-URL erreichbar
Features__MonetizationEnabled=true

# Login/Registrierung im UI sichtbar?
#   true  = sichtbar (Standard)
#   false = Anmelden-/Registrieren-Links ausgeblendet;
#           /Account/Login bleibt per Direkt-URL erreichbar
Features__LoginEnabled=true

# Öffentliche Adresse der Anwendung (siehe docs/08-oeffentliche-basis-url.md).
# Basis aller absoluten URLs, die nach außen gehen: RSS-Feed, Bestätigungs- und
# Abmelde-Links in E-Mails, Zahlungs-Rückkehr-URLs.
#
# Site__PublicBaseUrl=
#   Leer (Standard) = die Adresse wird aus dem HTTP-Request abgeleitet
#   (Schema + Host). Hinter einem Reverse-Proxy funktioniert das nur, wenn die
#   Forwarded-Header ausgewertet werden (siehe unten).
#   Gesetzt (empfohlen für Produktion) = feste öffentliche Adresse, z. B.
#   https://mentalversagen.de — dann ist die Adresse unabhängig von Proxy,
#   Host-Header und Port-Mapping.
#
# Site__UseForwardedHeaders=true
#   X-Forwarded-Proto/Host/For des Reverse Proxys auswerten (Standard: true).
#   Nötig, wenn die App hinter nginx/Traefik/Caddy läuft. Voraussetzung: der
#   Proxy setzt diese Header.
#
# Site__KnownProxies=
#   Komma-getrennte IP-Adressen vertrauenswürdiger Proxies. Leer = allen
#   Proxies wird vertraut (typisch für Container-Netze). Für eine direkt aus
#   dem Internet erreichbare App hier die Proxy-IP(s) eintragen, sonst sind
#   Host-Header und Client-IP manipulierbar.

# Mailversand (siehe docs/04-mailversand.md)
# Ohne Zugangsdaten bleibt der Dev-Fallback aktiv: die App startet dann zwar,
# aber es werden keine E-Mails zugestellt. Auf Produktion MUSS Provider=Smtp
# gesetzt sein, sonst laufen Registrierungs- und Newsletter-Bestätigungen ins Leere.
#
# Email__Password=<GEHEIM>  <-- NIE in eine committete Datei, nur in .env
#
#   Email__Provider=Smtp
#   Email__Host=smtp.ionos.com
#   Email__Port=587
#   Email__UseStartTls=true
#   Email__UserName=noreply@mentalversagen.de
#   Email__Password=
#   Email__FromAddress=noreply@mentalversagen.de
#   Email__FromDisplayName=MentalVersagen

# Management-API (Artikel per API anlegen/bearbeiten/löschen,
# siehe plans/api-artikelverwaltung.md und docs/05-management-api.md)
#
# Statischer API-Key für /api/v1. Erzeugung eines sicheren Keys:
#   openssl rand -hex 32
# Der Key wird als Header "X-Api-Key" übermittelt. NIE committen.
# Ohne Key bleibt die API geschlossen (Fail-Closed).
#
#   Api__Key=
#
# UUID eines bestehenden Benutzers mit Rolle Author oder Admin. Über die API
# angelegte Artikel werden diesem Autor zugeordnet. Ohne diesen Wert wird nur
# das Anlegen neuer Artikel abgelehnt (503).
#
#   Api__AuthorId=
#
# Interaktive Swagger-Oberfläche unter /swagger. Die maschinenlesbare Spec
# /swagger/v1/swagger.json bleibt davon unberührt immer erreichbar.
#   Api__SwaggerUiEnabled=true
#
# Anfragen-Limit pro Minute und Client-IP (Standard: 60).
#   Api__RateLimitPerMinute=60
