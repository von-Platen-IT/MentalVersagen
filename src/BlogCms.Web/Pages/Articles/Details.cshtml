@page
@using BlogCms.Domain.Enums
@using BlogCms.Web.Content
@model BlogCms.Web.Pages.Articles.DetailsModel
@{
    ViewData["Title"] = Model.Article?.Title ?? "Aktenstück";

    if (Model.Article is null)
    {
        <h1>Aktenstück nicht gefunden</h1>
        return;
    }

    var article = Model.Article;
    var disclaimer = CategoryDisplay.Disclaimer(article.Category);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 3,
        Title = article.Title,
        Meta = $"ARCHIV {article.Category.ToString().ToUpperInvariant()} · {article.PublishedAt?.ToString("dd.MM.yyyy") ?? "–"}"
    };
}

<partial name="_PageHeader" model="header" />

@if (!string.IsNullOrWhiteSpace(Model.TitleImageUrl))
{
    <figure class="mv-title-image mt-4 mb-0">
        <img src="@Model.TitleImageUrl" alt="@(Model.TitleImageAlt ?? article.Title)" decoding="async" />
    </figure>
}

<article class="mt-3">
    @if (disclaimer is not null)
    {
        <div class="mv-teaser mb-3" role="note">
            <strong>Hinweis:</strong> @disclaimer
        </div>
    }

    <div class="mv-doc">
        @if (!string.IsNullOrWhiteSpace(article.Excerpt))
        {
            <p class="lead">@article.Excerpt</p>
        }

        @if (Model.CanReadContent)
        {
            <div class="article-content">
                @Html.Raw(Model.ContentHtml)
            </div>
        }
        else
        {
            <p class="lead mb-3">@article.Excerpt</p>
            <div class="mv-teaser">
                @if (Model.RequiresPremium)
                {
                    <span class="mv-stamped mb-2">CLASSIFIED</span>
                    <p class="mb-2">Diese Akte ist Premium-Mitgliedern vorbehalten.</p>
                    @if (FeatureConfig.Value.MonetizationEnabled)
                    {
                        <a class="btn btn-primary" asp-page="/Membership/Index">Mitglied werden</a>
                    }
                    @if (!isAuthenticated && FeatureConfig.Value.LoginEnabled)
                    {
                        <a class="btn btn-outline-secondary" asp-page="/Account/Login">Anmelden</a>
                    }
                }
                else
                {
                    <p class="mb-2">Diese Akte ist nur für angemeldete Leser zugänglich.</p>
                    @if (FeatureConfig.Value.LoginEnabled)
                    {
                        <a class="btn btn-primary" asp-page="/Account/Login">Anmelden</a>
                        <a class="btn btn-outline-secondary" asp-page="/Account/Register">Registrieren</a>
                    }
                }
            </div>
        }
    </div>

    @if (Model.CanReadContent && article.VideoEmbeds.Count > 0)
    {
        <div class="mv-doc mt-3">
            @foreach (var video in article.VideoEmbeds)
            {
                @Html.Raw(BlogCms.Web.Content.VideoEmbedRenderer.Render(video))
            }
        </div>
    }

    @if (Model.CanReadContent && Model.GalleryImages.Count > 0)
    {
        <section class="mt-3" aria-label="Bilder dieser Akte">
            <p class="meta-mono mb-2">Bilder dieser Akte</p>
            <div class="mv-gallery">
                @foreach (var img in Model.GalleryImages)
                {
                    <a class="mv-gallery__item" href="@Model.GetImageUrl(img)" data-lightbox>
                        <img src="@Model.GetImageUrl(img)" alt="@(img.AltText ?? article.Title)" loading="lazy" decoding="async" />
                    </a>
                }
            </div>
        </section>
    }

    @if (article.ArticleTags.Count > 0 || article.ArticleHashtags.Count > 0)
    {
        <div class="mt-3 d-flex flex-wrap gap-1">
            @foreach (var at in article.ArticleTags)
            {
                <a class="mv-pill" asp-page="/Suche" asp-route-tag="@at.Tag?.Slug">#@at.Tag?.Name</a>
            }
            @foreach (var ah in article.ArticleHashtags)
            {
                <a class="mv-pill" asp-page="/Suche" asp-route-hashtag="@ah.Hashtag?.Slug">#@ah.Hashtag?.Name</a>
            }
        </div>
    }

    <section class="mt-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="meta-mono">Bewertung dieser Akte</span>
            <span class="mv-badge">👍 @Model.ArticleRating.ThumbUp</span>
            <span class="mv-badge">👎 @Model.ArticleRating.ThumbDown</span>
            <span class="meta-mono">Score: @Model.ArticleRating.Score</span>
        </div>

        @if (isAuthenticated)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                <form method="post" asp-page-handler="RateArticle" asp-route-slug="@article.Slug">
                    <input type="hidden" name="value" value="ThumbUp" />
                    <button type="submit" class="btn btn-sm @(Model.UserArticleRating == RatingValue.ThumbUp ? "btn-primary" : "btn-outline-secondary")">👍 Lob</button>
                </form>
                <form method="post" asp-page-handler="RateArticle" asp-route-slug="@article.Slug">
                    <input type="hidden" name="value" value="ThumbDown" />
                    <button type="submit" class="btn btn-sm @(Model.UserArticleRating == RatingValue.ThumbDown ? "btn-primary" : "btn-outline-secondary")">👎 Kritik</button>
                </form>
            </div>
        }
        else if (FeatureConfig.Value.LoginEnabled)
        {
            <p class="meta-mono mt-2 mb-0">
                <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Articles/Details", new { slug = article.Slug })">Melde dich an</a>, um die Akte zu bewerten.
            </p>
        }
    </section>
</article>

@{
    Guid RootOf(BlogCms.Domain.Entities.Comment c)
    {
        var current = c;
        var guard = 0;
        while (current.ParentCommentId is not null && guard++ < 10)
        {
            var parent = Model.Comments.FirstOrDefault(x => x.Id == current.ParentCommentId);
            if (parent is null) break;
            current = parent;
        }
        return current.Id;
    }

    var roots = Model.Comments
        .Where(c => c.ParentCommentId is null)
        .OrderByDescending(c => c.IsHighlighted)
        .ThenBy(c => c.CreatedAt)
        .ToList();
    var repliesOf = (Guid rootId) => Model.Comments
        .Where(c => c.ParentCommentId is not null && RootOf(c) == rootId)
        .OrderBy(c => c.CreatedAt)
        .ToList();
}

<section id="comments" class="mt-5">
    <h2 class="h4">Kommentare (@Model.Comments.Count(c => c.DeletedAt is null))</h2>

    @if (TempData["CommentMessage"] is string okMessage)
    {
        <div class="mv-teaser mt-2">@okMessage</div>
    }
    @if (TempData["CommentError"] is string errorMessage)
    {
        <div class="mv-teaser mt-2">@errorMessage</div>
    }

    @if (!isAuthenticated && FeatureConfig.Value.LoginEnabled)
    {
        <p class="meta-mono">
            <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Articles/Details", new { slug = article.Slug })">Anmelden</a>,
            um zu kommentieren.
        </p>
    }
    else if (isAuthenticated)
    {
        <form method="post" asp-page-handler="AddComment" asp-route-slug="@article.Slug" enctype="multipart/form-data" class="mb-4">
            <div class="mb-2">
                <textarea name="content" class="form-control" rows="3" maxlength="5000" placeholder="Deine Zeugnis ..." required></textarea>
            </div>
            <div class="mb-2">
                <input type="file" name="image" accept="image/*" class="form-control form-control-sm"
                       data-max-bytes="4194304" data-max-label="4 MB" />
                <div class="form-text" data-file-hint>
                    Optional: Bild anhängen (max. 4 MB, JPEG/PNG/WebP/GIF).
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Kommentar absenden</button>
        </form>
    }

    @foreach (var root in roots)
    {
        var rootDeleted = root.DeletedAt is not null;
        var rootSummary = Model.CommentRatings.TryGetValue(root.Id, out var rs) ? rs : BlogCms.Infrastructure.Ratings.RatingSummary.Empty;
        <div class="mv-comment @(root.IsHighlighted ? "mv-comment--highlight" : "") mb-3" id="comment-@root.Id">
            <div class="d-flex justify-content-between align-items-start">
                <strong>
                    @if (root.IsHighlighted)
                    {
                        <span class="mv-badge mv-badge--red me-1">Ausgezeichnet</span>
                    }
                    @(root.User?.DisplayName ?? "Gelöschter Nutzer")
                </strong>
                <small class="meta-mono">
                    @root.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    @if (root.EditedAt is not null)
                    {
                        <text> · bearbeitet</text>
                    }
                </small>
            </div>

            @if (rootDeleted)
            {
                <p class="text-muted fst-italic mb-1">Kommentar gelöscht</p>
            }
            else
            {
                <p class="mb-1 mv-preline">@root.ContentText</p>
                @foreach (var img in root.MediaAssets)
                {
                    var commentImageUrl = Model.GetImageUrl(img);
                    <a class="mv-thumb" href="@commentImageUrl" data-lightbox>
                        <img src="@commentImageUrl" alt="@(img.AltText ?? "Kommentarbild")" loading="lazy" decoding="async" />
                    </a>
                }
            }

            <div class="d-flex align-items-center gap-2 small mt-1 flex-wrap">
                <span class="mv-badge">👍 @rootSummary.ThumbUp</span>
                <span class="mv-badge">👎 @rootSummary.ThumbDown</span>

                @if (!rootDeleted && isAuthenticated)
                {
                    <form method="post" asp-page-handler="RateComment" asp-route-slug="@article.Slug">
                        <input type="hidden" name="commentId" value="@root.Id" />
                        <input type="hidden" name="value" value="ThumbUp" />
                        <button type="submit" class="btn btn-link btn-sm p-0">👍</button>
                    </form>
                    <form method="post" asp-page-handler="RateComment" asp-route-slug="@article.Slug">
                        <input type="hidden" name="commentId" value="@root.Id" />
                        <input type="hidden" name="value" value="ThumbDown" />
                        <button type="submit" class="btn btn-link btn-sm p-0">👎</button>
                    </form>
                }
            </div>

            @if (!rootDeleted && isAuthenticated)
            {
                var isOwner = root.UserId.ToString() == currentUserId;
                <div class="small mt-2">
                    <details>
                        <summary class="text-secondary mv-summary">Antworten</summary>
                        <form method="post" asp-page-handler="AddComment" asp-route-slug="@article.Slug" class="mt-2">
                            <input type="hidden" name="parentId" value="@root.Id" />
                            <textarea name="content" class="form-control form-control-sm" rows="2" required></textarea>
                            <button type="submit" class="btn btn-outline-secondary btn-sm mt-1">Antwort senden</button>
                        </form>
                    </details>

                    @if (Model.CanModerateComments)
                    {
                        <form method="post" asp-page-handler="HighlightComment" asp-route-slug="@article.Slug" class="d-inline">
                            <input type="hidden" name="commentId" value="@root.Id" />
                            <input type="hidden" name="highlighted" value="@((!root.IsHighlighted).ToString().ToLower())" />
                            <button type="submit" class="btn btn-link btn-sm p-0">
                                @(root.IsHighlighted ? "Auszeichnung entfernen" : "Auszeichnen")
                            </button>
                        </form>
                    }

                    @if (isOwner || Model.CanModerateComments)
                    {
                        <form method="post" asp-page-handler="DeleteComment" asp-route-slug="@article.Slug" class="d-inline"
                              onsubmit="return confirm('Kommentar löschen?');">
                            <input type="hidden" name="commentId" value="@root.Id" />
                            <button type="submit" class="btn btn-link btn-sm mv-text-danger p-0">Löschen</button>
                        </form>
                    }

                    @if (isOwner)
                    {
                        <details class="mt-1">
                            <summary class="text-secondary mv-summary">Bearbeiten</summary>
                            <form method="post" asp-page-handler="EditComment" asp-route-slug="@article.Slug" class="mt-2">
                                <input type="hidden" name="commentId" value="@root.Id" />
                                <textarea name="content" class="form-control form-control-sm" rows="2" required>@root.ContentText</textarea>
                                <button type="submit" class="btn btn-outline-secondary btn-sm mt-1">Speichern</button>
                            </form>
                        </details>
                    }

                    @if (!isOwner)
                    {
                        <details class="mt-1">
                            <summary class="text-secondary mv-summary">Melden</summary>
                            <form method="post" asp-page-handler="ReportComment" asp-route-slug="@article.Slug" class="mt-2">
                                <input type="hidden" name="commentId" value="@root.Id" />
                                <select name="reason" class="form-select form-select-sm mb-1" asp-items="Html.GetEnumSelectList<BlogCms.Domain.Enums.ReportReason>()"></select>
                                <input name="note" class="form-control form-control-sm mb-1" placeholder="Optionaler Hinweis" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Meldung senden</button>
                            </form>
                        </details>
                    }
                </div>
            }

            @foreach (var reply in repliesOf(root.Id))
            {
                var replyDeleted = reply.DeletedAt is not null;
                var replySummary = Model.CommentRatings.TryGetValue(reply.Id, out var rr) ? rr : BlogCms.Infrastructure.Ratings.RatingSummary.Empty;
                <div class="border-start ps-3 mt-3 ms-3 @(reply.IsHighlighted ? "border-danger" : "")" id="comment-@reply.Id">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong>
                            @if (reply.IsHighlighted)
                            {
                                <span class="mv-badge mv-badge--red me-1">Ausgezeichnet</span>
                            }
                            @(reply.User?.DisplayName ?? "Gelöschter Nutzer")
                        </strong>
                        <small class="meta-mono">
                            @reply.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            @if (reply.EditedAt is not null)
                            {
                                <text> · bearbeitet</text>
                            }
                        </small>
                    </div>

                    @if (replyDeleted)
                    {
                        <p class="text-muted fst-italic mb-1">Kommentar gelöscht</p>
                    }
                    else
                    {
                        <p class="mb-1 mv-preline">@reply.ContentText</p>
                        @foreach (var img in reply.MediaAssets)
                        {
                            var replyImageUrl = Model.GetImageUrl(img);
                            <a class="mv-thumb" href="@replyImageUrl" data-lightbox>
                                <img src="@replyImageUrl" alt="@(img.AltText ?? "Kommentarbild")" loading="lazy" decoding="async" />
                            </a>
                        }
                    }

                    <div class="d-flex align-items-center gap-2 small mt-1 flex-wrap">
                        <span class="mv-badge">👍 @replySummary.ThumbUp</span>
                        <span class="mv-badge">👎 @replySummary.ThumbDown</span>
                        @if (!replyDeleted && isAuthenticated)
                        {
                            <form method="post" asp-page-handler="RateComment" asp-route-slug="@article.Slug">
                                <input type="hidden" name="commentId" value="@reply.Id" />
                                <input type="hidden" name="value" value="ThumbUp" />
                                <button type="submit" class="btn btn-link btn-sm p-0">👍</button>
                            </form>
                            <form method="post" asp-page-handler="RateComment" asp-route-slug="@article.Slug">
                                <input type="hidden" name="commentId" value="@reply.Id" />
                                <input type="hidden" name="value" value="ThumbDown" />
                                <button type="submit" class="btn btn-link btn-sm p-0">👎</button>
                            </form>
                        }
                    </div>

                    @if (!replyDeleted && isAuthenticated)
                    {
                        var replyIsOwner = reply.UserId.ToString() == currentUserId;
                        <div class="small mt-2">
                            @if (Model.CanModerateComments)
                            {
                                <form method="post" asp-page-handler="HighlightComment" asp-route-slug="@article.Slug" class="d-inline">
                                    <input type="hidden" name="commentId" value="@reply.Id" />
                                    <input type="hidden" name="highlighted" value="@((!reply.IsHighlighted).ToString().ToLower())" />
                                    <button type="submit" class="btn btn-link btn-sm p-0">
                                        @(reply.IsHighlighted ? "Auszeichnung entfernen" : "Auszeichnen")
                                    </button>
                                </form>
                            }
                            @if (replyIsOwner || Model.CanModerateComments)
                            {
                                <form method="post" asp-page-handler="DeleteComment" asp-route-slug="@article.Slug" class="d-inline"
                                      onsubmit="return confirm('Kommentar löschen?');">
                                    <input type="hidden" name="commentId" value="@reply.Id" />
                                    <button type="submit" class="btn btn-link btn-sm mv-text-danger p-0">Löschen</button>
                                </form>
                            }
                            @if (!replyIsOwner)
                            {
                                <details class="mt-1">
                                    <summary class="text-secondary mv-summary">Melden</summary>
                                    <form method="post" asp-page-handler="ReportComment" asp-route-slug="@article.Slug" class="mt-2">
                                        <input type="hidden" name="commentId" value="@reply.Id" />
                                        <select name="reason" class="form-select form-select-sm mb-1" asp-items="Html.GetEnumSelectList<BlogCms.Domain.Enums.ReportReason>()"></select>
                                        <input name="note" class="form-control form-control-sm mb-1" placeholder="Optionaler Hinweis" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Meldung senden</button>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (roots.Count == 0)
    {
        <p class="text-muted">Noch keine Zeugnisse.</p>
    }
</section>
