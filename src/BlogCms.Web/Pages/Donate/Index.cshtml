@page
@model BlogCms.Web.Pages.Donate.IndexModel
@{
    ViewData["Title"] = "Spenden";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 2,
        Title = "Einmalig spenden",
        Sub = "Ganz ohne Abo – freiwillig und anonym möglich."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    @if (Model.Message is not null)
    {
        <div class="mv-teaser mb-3">@Model.Message</div>
    }

    <form method="post" class="row g-3" style="max-width:520px;">
        <div class="col-6">
            <label class="form-label" for="Amount">Betrag</label>
            <input class="form-control" id="Amount" name="Amount" type="number" min="1" step="1" value="@Model.Amount" />
        </div>
        <div class="col-6">
            <label class="form-label" for="Currency">Währung</label>
            <select class="form-select" id="Currency" name="Currency">
                <option value="EUR" selected="@(Model.Currency == "EUR")">EUR</option>
                <option value="USD" selected="@(Model.Currency == "USD")">USD</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="Email">E-Mail (optional)</label>
            <input class="form-control" id="Email" name="Email" type="email" value="@Model.Email" autocomplete="email" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Spenden</button>
        </div>
    </form>

    <p class="meta-mono mt-3 mb-0">
        Ohne Anmeldung möglich — anonyme Spenden werden ohne Nutzerkonto gespeichert.
    </p>
</div>
