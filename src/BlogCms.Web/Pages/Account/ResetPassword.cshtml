@page
@model BlogCms.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Neues Passwort";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 1,
        Title = "Neues Passwort",
        Sub = "Vergib ein neues Passwort für dein Konto."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div asp-validation-summary="ModelOnly" class="mv-text-danger"></div>

    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="mv-text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="mv-text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Passwort speichern</button>
    </form>

    <p class="meta-mono mt-3 mb-0">
        <a asp-page="/Account/ForgotPassword">Neuen Link anfordern</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
