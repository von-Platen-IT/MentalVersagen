@page
@model BlogCms.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registrieren";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 3,
        Title = "Registrieren",
        Sub = "Neuen Archivzugang anlegen (Double-Opt-in mit E-Mail)."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.DisplayName" class="form-label"></label>
            <input asp-for="Input.DisplayName" class="form-control" autocomplete="nickname" />
            <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Registrieren</button>
    </form>

    <p class="meta-mono mt-3 mb-0">
        Bereits dokumentiertes Konto? <a asp-page="/Account/Login">Anmelden</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
