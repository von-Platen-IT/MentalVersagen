@page
@model BlogCms.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registrieren";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 3,
        Title = "Registrieren",
        Sub = "Neuen Archivzugang anlegen (Double-Opt-in mit E-Mail)."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div asp-validation-summary="ModelOnly" class="mv-text-danger"></div>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.DisplayName" class="form-label"></label>
            <input asp-for="Input.DisplayName" class="form-control" autocomplete="nickname" />
            <span asp-validation-for="Input.DisplayName" class="mv-text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="mv-text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="mv-text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="mv-text-danger"></span>
        </div>

        @*
            Sicherheitsabfrage: Die Aufgabe kommt vom Server, die erwartete Antwort
            steckt ausschließlich im signierten Token und wird immer serverseitig
            geprüft. Das JavaScript verbessert nur die Bedienung.
        *@
        <div class="mv-captcha mb-3"
             data-captcha
             data-captcha-endpoint="@Url.Page("/Account/Register", "Captcha")">
            <label class="form-label" for="CaptchaAnswer">Sicherheitsabfrage</label>
            <p class="mv-captcha__question" id="captcha-question" aria-live="polite">
                Wie viel ist <strong data-captcha-question>@Model.CaptchaQuestion</strong>?
            </p>
            <div class="mv-captcha__row">
                <input asp-for="CaptchaAnswer" class="form-control" inputmode="numeric"
                       autocomplete="off" aria-describedby="captcha-hint" />
                <button type="button" class="btn btn-outline-secondary" data-captcha-refresh>
                    Neue Aufgabe
                </button>
            </div>
            <input asp-for="CaptchaToken" type="hidden" />
            <p class="form-text" id="captcha-hint" data-captcha-hint>
                Bitte das Ergebnis eintragen — das schützt vor automatischen Registrierungen.
            </p>
            <span asp-validation-for="CaptchaAnswer" class="mv-text-danger"></span>
        </div>

        @* Honeypot: für Menschen unsichtbar, Bots füllen es aus. *@
        <div class="mv-honeypot" aria-hidden="true">
            <label for="ExtraField">Bitte nicht ausfüllen</label>
            <input asp-for="ExtraField" id="ExtraField" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-primary" data-captcha-submit>Registrieren</button>
    </form>

    <p class="meta-mono mt-3 mb-0">
        Bereits dokumentiertes Konto? <a asp-page="/Account/Login">Anmelden</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
