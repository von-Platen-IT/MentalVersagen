@page
@model BlogCms.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Passwort vergessen";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 1,
        Title = "Passwort vergessen",
        Sub = "Neues Passwort per E-Mail anfordern."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div asp-validation-summary="ModelOnly" class="mv-text-danger"></div>

    <p>
        Gib die E-Mail-Adresse deines Kontos ein. Wir senden dir einen Link,
        mit dem du ein neues Passwort vergeben kannst.
    </p>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="mv-text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Link anfordern</button>
    </form>

    <p class="meta-mono mt-3 mb-0">
        <a asp-page="/Account/Login">Zurück zur Anmeldung</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
