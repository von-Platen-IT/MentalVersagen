@page
@using BlogCms.Infrastructure.Content
@using BlogCms.Web.Content
@using BlogCms.Web.Extensions
@using BlogCms.Web.Seo
@model IndexModel
@{
    // Titel der Seite. Das Layout haengt den Seitennamen an - "Mentalversagen"
    // als Seitentitel wuerde sonst "Mentalversagen — Mentalversagen" entstehen.
    ViewData["Title"] = "Verschwörungen & Geheimnisse";
    ViewData[SeoMeta.TypeKey] = "website";
    ViewData[SeoMeta.DescriptionKey] =
        "Aufzeichnungen eines Verschwörungstheoretikers: unabhängige Recherche zu " +
        "Verschwörungen, Geheimnissen und verdeckten Hintergründen — als Aktenstücke " +
        "mit Belegen, Chronologie und offenen Fragen.";
    ViewData[SeoMeta.ImageKey] = $"{ViewContext.HttpContext.GetPublicBaseUrl()}/pics/background_landing_page.png";
}

<header class="page-header page-header--landing" style="--ph-img: url('/pics/background_landing_page.png');">
    <div class="hero-brand">
        <img class="hero-logo-float" src="/pics/Mentalversagen_schriftzug.png" alt="" aria-hidden="true" decoding="async" />
        <p class="hero-motto">Aufzeichnungen eines Verschwörungstheoretikers</p>
    </div>
</header>

<section class="hero-actions" aria-label="Schnellzugriff">
    <div class="hero-cta">
        @* „Mitglied werden" ist der primäre CTA und trägt den roten Glow. *@
        @if (FeatureConfig.Value.MonetizationEnabled)
        {
            <a class="btn btn-primary" asp-page="/Unterstuetzer/Index">Mitglied werden</a>
        }
    </div>

    @*
        Hashtag-Suche, Kategorie und Sortierung im gleichen Rahmen-Stil wie die
        Buttons. Die Hashtag-Liste kommt per REST (/api/hashtags), das Grid wird
        beim Filtern/Sortieren per REST (/api/articles) ohne Neuladen aktualisiert.
        Ohne JavaScript bleibt das serverseitig gerenderte Grid sichtbar.
    *@
    <div class="hero-tools"
         data-article-tools
         data-api="/api/articles"
         data-hashtag-api="/api/hashtags"
         data-page-size="@Model.ArticlesPerPage"
         data-filtered-page-size="@(Model.ArticlesPerPage * 2)">

        <div class="mv-search" data-autocomplete>
            <label class="visually-hidden" for="hashtag-search">Nach Hashtag suchen</label>
            <input type="search"
                   id="hashtag-search"
                   class="mv-search__input"
                   placeholder="# Hashtag suchen …"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="false"
                   aria-controls="hashtag-list"
                   aria-autocomplete="list" />
            <ul class="mv-search__list" id="hashtag-list" role="listbox" aria-label="Passende Hashtags" hidden></ul>
        </div>

        <div class="mv-category">
            <label class="visually-hidden" for="category-filter">Kategorie</label>
            <select id="category-filter" class="mv-category__select">
                <option value="">Alle Kategorien</option>
                @foreach (var topic in Model.Topics)
                {
                    <option value="@topic.Slug"
                            selected="@(Model.ActiveCategories.Count == 1 && Model.ActiveCategories[0].Slug == topic.Slug)">@topic.Name</option>
                }
            </select>
        </div>

        <div class="mv-sort">
            <label class="visually-hidden" for="sort-order">Sortierung</label>
            <select id="sort-order" class="mv-sort__select">
                @* Die acht Sortieroptionen in der Nutzervorgabe-Reihenfolge;
                   Standard ist "Neueste zuerst". *@
                @foreach (var value in new[]
                {
                    ArticleSortOrder.Newest,
                    ArticleSortOrder.Oldest,
                    ArticleSortOrder.MostViewed,
                    ArticleSortOrder.LeastViewed,
                    ArticleSortOrder.MostUpvoted,
                    ArticleSortOrder.LeastUpvoted,
                    ArticleSortOrder.MostDownvoted,
                    ArticleSortOrder.LeastDownvoted
                })
                {
                    <option value="@value" selected="@(value == Model.Sort)">@SortDisplay.Label(value)</option>
                }
            </select>
        </div>
    </div>

    @if (Model.HasActiveFilter)
    {
        <div class="mv-active-filters" aria-label="Aktive Filter">
            <span class="meta-mono">Aktive Filter:</span>
            @foreach (var category in Model.ActiveCategories)
            {
                <a class="mv-filter-chip" href="@Model.BuildFilterUrl(removeCategory: category.Slug)"
                   title="Filter „@category.Name“ entfernen">@category.Name <span aria-hidden="true">×</span></a>
            }
            @foreach (var hashtag in Model.ActiveHashtags)
            {
                <a class="mv-filter-chip" href="@Model.BuildFilterUrl(removeHashtag: hashtag.Slug)"
                   title="Filter „#@hashtag.Name“ entfernen">#@hashtag.Name <span aria-hidden="true">×</span></a>
            }
            <a class="mv-filter-chip mv-filter-chip--reset" href="/">Alle Filter entfernen</a>
        </div>
    }

    <div class="mv-bookmark">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bookmark-url>
            Diese Auswahl als Lesezeichen speichern
        </button>
        <span class="meta-mono" data-bookmark-hint hidden>Link kopiert.</span>
    </div>

    <p class="mv-filter-status" data-filter-status hidden></p>
</section>

<div class="mt-4">
    <p class="meta-mono mb-3" data-grid-heading>Neueste Akten</p>

    <p class="text-muted" data-grid-empty @(Model.LatestArticles.Count == 0 ? null : "hidden")>
        Keine Akten gefunden.
    </p>

    <div class="mv-cases" data-article-grid>
        @foreach (var article in Model.LatestArticles)
        {
            <partial name="_ArticleCard"
                     model="@(new BlogCms.Web.Models.ArticleCardModel { Article = article, ImageUrl = Model.TitleImageUrl(article) })" />
        }
    </div>
</div>
