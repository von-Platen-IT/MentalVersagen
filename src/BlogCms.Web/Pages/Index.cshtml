@page
@using BlogCms.Infrastructure.Content
@using BlogCms.Web.Content
@model IndexModel
@{
    ViewData["Title"] = "Mentalversagen";
}

<header class="page-header page-header--landing" style="--ph-img: url('/pics/background_landing_page.png');">
    <div class="hero-brand">
        <img class="hero-logo-float" src="/pics/Mentalversagen_schriftzug.png" alt="" aria-hidden="true" decoding="async" />
        <p class="hero-motto">Aufzeichnungen eines Verschwörungstheoretikers</p>
    </div>
</header>

<section class="hero-actions" aria-label="Schnellzugriff">
    <div class="hero-cta">
        @* „Mitglied werden" ist der primäre CTA und trägt den roten Glow. *@
        @if (FeatureConfig.Value.MonetizationEnabled)
        {
            <a class="btn btn-primary" asp-page="/Membership/Index">Mitglied werden</a>
        }
    </div>

    @*
        Hashtag-Suche und Sortierung im gleichen Rahmen-Stil wie die Buttons.
        Die Hashtag-Liste kommt per REST (/api/hashtags), das Grid wird beim
        Filtern/Sortieren per REST (/api/articles) ohne Neuladen aktualisiert.
        Ohne JavaScript bleibt das serverseitig gerenderte Grid sichtbar.
    *@
    <div class="hero-tools"
         data-article-tools
         data-api="/api/articles"
         data-hashtag-api="/api/hashtags"
         data-page-size="6"
         data-filtered-page-size="12">

        <div class="mv-search" data-autocomplete>
            <label class="visually-hidden" for="hashtag-search">Nach Hashtag suchen</label>
            <input type="search"
                   id="hashtag-search"
                   class="mv-search__input"
                   placeholder="# Hashtag suchen …"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="false"
                   aria-controls="hashtag-list"
                   aria-autocomplete="list" />
            <ul class="mv-search__list" id="hashtag-list" role="listbox" aria-label="Passende Hashtags" hidden></ul>
        </div>

        <div class="mv-sort">
            <label class="visually-hidden" for="sort-order">Sortierung</label>
            <select id="sort-order" class="mv-sort__select">
                @foreach (var value in Enum.GetValues<ArticleSortOrder>())
                {
                    <option value="@value" selected="@(value == ArticleSortOrder.Newest)">@SortDisplay.Label(value)</option>
                }
            </select>
        </div>

        <a class="mv-search-link" asp-page="/Suche">Erweiterte Suche</a>
    </div>

    <p class="mv-filter-status" data-filter-status hidden></p>
</section>

<div class="mt-4">
    <p class="meta-mono mb-3" data-grid-heading>Neueste Akten</p>

    <p class="text-muted" data-grid-empty @(Model.LatestArticles.Count == 0 ? null : "hidden")>
        Keine Akten gefunden.
    </p>

    <div class="mv-cases" data-article-grid>
        @foreach (var article in Model.LatestArticles)
        {
            var image = Model.TitleImageUrl(article);
            <article class="mv-case">
                <div class="mv-case__head">
                    <span>ARCHIV @article.Category.ToString().ToUpperInvariant()</span>
                    <span class="text-end">#@article.Id.ToString("N").Substring(0, 8).ToUpperInvariant()</span>
                </div>
                @if (image is not null)
                {
                    <a class="mv-case__img" asp-page="/Articles/Details" asp-route-slug="@article.Slug">
                        <img src="@image" alt="@article.Title" loading="lazy" decoding="async" />
                    </a>
                }
                <div class="mv-case__body">
                    <h3 class="mv-case__title">
                        <a asp-page="/Articles/Details" asp-route-slug="@article.Slug">@article.Title</a>
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(article.Excerpt))
                    {
                        <p class="mv-case__excerpt">@article.Excerpt</p>
                    }
                    <div class="mv-case__meta">
                        <span class="mv-badge mv-badge--open">? OFFEN</span>
                        <span>@ArticleDisplay.AccessLabel(article.AccessLevel)</span>
                        <span>@article.PublishedAt?.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
                <div class="mv-case__footer">
                    <span>@(article.Author?.DisplayName ?? "Archiv")</span>
                    <a class="mv-case__next" asp-page="/Articles/Details" asp-route-slug="@article.Slug">WEITER &rarr;</a>
                </div>
            </article>
        }
    </div>
</div>
