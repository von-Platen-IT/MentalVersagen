@page
@model BlogCms.Web.Pages.Admin.LinkLists.IndexModel
@{
    ViewData["Title"] = "Kuratierungen";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 2,
        Title = "Kuratierungen",
        Sub = "Linklisten (Linklisten) verwalten."
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Linklisten</h2>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Articles/Index">Zur Aktenverwaltung</a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="mv-teaser mb-3">@message</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="mv-teaser mb-3">@error</div>
    }

    <div class="row">
        <div class="col-md-7">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Slug</th>
                        <th>Akten</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var list in Model.LinkLists)
                {
                    <tr>
                        <td>@list.Title</td>
                        <td><code>/LinkLists/@list.Slug</code></td>
                        <td>@list.Items.Count</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@list.Id">Bearbeiten</a>
                            <a class="btn btn-sm btn btn-primary" asp-page="/LinkLists/Details" asp-route-slug="@list.Slug" target="_blank">Ansehen</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@list.Id" class="d-inline"
                                  onsubmit="return confirm('Linkliste wirklich löschen?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            @if (Model.LinkLists.Count == 0)
            {
                <p class="text-muted">Noch keine Linklisten vorhanden.</p>
            }
        </div>

        <div class="col-md-5">
            <div class="mv-case">
                <div class="mv-case__head">
                    <span>NEUE LINKLISTE</span>
                </div>
                <div class="mv-case__body">
                    <form method="post" asp-page-handler="Create">
                        <div class="mb-2">
                            <label class="form-label" for="Title">Titel</label>
                            <input class="form-control" id="Title" name="Title" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="Slug">Slug (optional)</label>
                            <input class="form-control" id="Slug" name="Slug" placeholder="automatisch aus Titel" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="Description">Beschreibung</label>
                            <textarea class="form-control" id="Description" name="Description" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Anlegen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
