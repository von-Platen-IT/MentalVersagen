@page "{id:guid}"
@model BlogCms.Web.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Kategorie bearbeiten";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Title = "Kategorie bearbeiten",
        Sub = Model.Category.Name,
        Meta = Model.Category.IsSystem ? "SYSTEMKATEGORIE" : "KATEGORIE"
    };
}

<partial name="_PageHeader" model="header" />

<div class="mv-doc mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0">@Model.Category.Name</h2>
        <a class="btn btn-outline-secondary" asp-page="Index">Zurück zur Übersicht</a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="mv-teaser mb-3 mv-text-danger" role="alert">@error</div>
    }

    @if (Model.Category.IsSystem)
    {
        <div class="mv-teaser mb-3" role="note">
            Die Systemkategorie „undefined“ kann nicht umbenannt oder gelöscht werden.
            Beschreibung, Disclaimer und Reihenfolge sind editierbar.
        </div>
    }

    <form method="post" class="mv-create">
        <div class="mv-create__grid">
            <div class="mv-create__field">
                <label class="form-label" asp-for="Name">Name</label>
                <input class="form-control" asp-for="Name" required maxlength="100"
                       readonly="@(Model.Category.IsSystem ? "readonly" : null)" />
            </div>
            <div class="mv-create__field">
                <label class="form-label" asp-for="Slug">Slug</label>
                <input class="form-control" asp-for="Slug" maxlength="100"
                       readonly="@(Model.Category.IsSystem ? "readonly" : null)" />
                <div class="form-text">
                    @(Model.Category.IsSystem
                        ? "Der Slug der Systemkategorie ist fest."
                        : "Bleibt bei einer Umbenennung unverändert, solange kein neuer Slug angegeben wird.")
                </div>
            </div>
            <div class="mv-create__field mv-create__field--full">
                <label class="form-label" asp-for="Description">Beschreibung (optional)</label>
                <textarea class="form-control" asp-for="Description" rows="2" maxlength="500"></textarea>
            </div>
            <div class="mv-create__field mv-create__field--full">
                <label class="form-label" asp-for="Disclaimer">Disclaimer (optional)</label>
                <textarea class="form-control" asp-for="Disclaimer" rows="4" maxlength="1000"
                          placeholder="Hinweistext, der auf der Artikelseite erscheint."></textarea>
                <div class="form-text">Wird auf jeder Artikelseite dieser Kategorie eingeblendet.</div>
            </div>
            <div class="mv-create__field">
                <label class="form-label" asp-for="DisplayOrder">Reihenfolge</label>
                <input class="form-control" asp-for="DisplayOrder" type="number" min="0" />
            </div>
        </div>

        <div class="mv-create__actions d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Änderungen speichern</button>
            <a class="btn btn-outline-secondary ms-auto" asp-page="Index">Abbrechen</a>
        </div>
    </form>
</div>