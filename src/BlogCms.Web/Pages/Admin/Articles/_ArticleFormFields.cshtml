@using BlogCms.Domain.Enums
@using BlogCms.Web.Models
@model ArticleInputModel

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Slug" class="form-label"></label>
    <input asp-for="Slug" class="form-control" placeholder="wird sonst automatisch erzeugt" />
    <span asp-validation-for="Slug" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Excerpt" class="form-label"></label>
    <textarea asp-for="Excerpt" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Excerpt" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ArticleCategory>()"></select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ArticleStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Tags" class="form-label"></label>
        <input asp-for="Tags" class="form-control" placeholder="z. B. parteien, wahlen" />
        <span asp-validation-for="Tags" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="IsPremium" class="form-check-input" />
    <label asp-for="IsPremium" class="form-check-label"></label>
</div>

<div class="mb-3">
    <label asp-for="ContentMarkdown" class="form-label"></label>
    <textarea asp-for="ContentMarkdown" class="form-control font-monospace" rows="16"></textarea>
    <div class="form-text">Markdown wird beim Ausliefern serverseitig gerendert und sanitized.</div>
    <span asp-validation-for="ContentMarkdown" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="VideoUrl" class="form-label"></label>
    <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
    <div class="form-text">Wird per oEmbed aufgelöst. Nicht unterstützte Plattformen werden nur verlinkt.</div>
    <span asp-validation-for="VideoUrl" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImageUpload" class="form-label"></label>
    <input asp-for="ImageUpload" type="file" accept="image/*" class="form-control" />
    <div class="form-text">JPEG, PNG, WebP oder GIF. Wird geprüft, skaliert und ohne EXIF gespeichert.</div>
    <span asp-validation-for="ImageUpload" class="text-danger"></span>
</div>
