@page
@using BlogCms.Web.Content
@model BlogCms.Web.Pages.Admin.Articles.IndexModel
@{
    ViewData["Title"] = "Artikelverwaltung";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Artikelverwaltung</h1>
    <a class="btn btn-primary" asp-page="/Admin/Articles/Create">Neuer Artikel</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Kategorie</th>
            <th>Status</th>
            <th>Premium</th>
            <th>Veröffentlicht</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var article in Model.Articles)
    {
        <tr>
            <td>@article.Title</td>
            <td>
                <span class="badge @CategoryDisplay.BadgeClass(article.Category)">@CategoryDisplay.Label(article.Category)</span>
            </td>
            <td>@article.Status</td>
            <td>@(article.IsPremium ? "Ja" : "Nein")</td>
            <td>@(article.PublishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "–")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Articles/Edit" asp-route-id="@article.Id">Bearbeiten</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@article.Id" class="d-inline"
                      onsubmit="return confirm('Artikel wirklich löschen?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Articles.Count == 0)
{
    <p class="text-muted">Noch keine Artikel vorhanden.</p>
}
