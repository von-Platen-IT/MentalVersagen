@page
@model BlogCms.Web.Pages.Admin.Articles.EditModel
@{
    ViewData["Title"] = "Artikel bearbeiten";
}

<h1>Artikel bearbeiten</h1>

<form method="post" asp-route-id="@Model.ArticleId" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_ArticleFormFields" model="Model.Input" />
    <button type="submit" class="btn btn-primary">Speichern</button>
    <a class="btn btn-secondary" asp-page="/Admin/Articles/Index">Abbrechen</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
