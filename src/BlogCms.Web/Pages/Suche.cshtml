@page
@using BlogCms.Domain.Enums
@using BlogCms.Infrastructure.Content
@using BlogCms.Web.Content
@model SucheModel
@{
    ViewData["Title"] = "Suche";
    var header = new BlogCms.Web.Models.PageHeaderModel
    {
        Slide = 2,
        Title = "Suche",
        Sub = "Volltext, Zeitraum, Hashtag und Sortierung kombiniert.",
        Meta = Model.HasFilter ? $"TREFFER: {Model.TotalCount}" : null
    };
}

<partial name="_PageHeader" model="header" />

<form method="get" class="mv-filter mt-4" aria-label="Akten durchsuchen">
    <div class="mv-filter__head">
        <span class="meta-mono">Recherche-Suche</span>
    </div>

    <div class="row g-3 align-items-end">
        <div class="col-12 col-lg-6">
            <label class="form-label" for="query">Volltext</label>
            <input class="form-control" id="query" name="query" value="@Model.Query"
                   placeholder="Titel, Kurzbeschreibung oder Inhalt" />
        </div>
        <div class="col-6 col-lg-3">
            <label class="form-label" for="category">Kategorie</label>
            <select class="form-select" id="category" name="category">
                <option value="">Alle Kategorien</option>
                @foreach (var value in Enum.GetValues<ArticleCategory>())
                {
                    <option value="@value" selected="@(Model.Category == value)">@CategoryDisplay.Label(value)</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label class="form-label" for="tag">Tag</label>
            <select class="form-select" id="tag" name="tag">
                <option value="">Alle Tags</option>
                @foreach (var t in Model.AllTags)
                {
                    <option value="@t.Slug" selected="@(Model.TagSlug == t.Slug)">@t.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="row g-3 align-items-end mt-1">
        <div class="col-6 col-md-3">
            <label class="form-label" for="dateFrom">Veröffentlicht ab</label>
            <input class="form-control" id="dateFrom" name="dateFrom" type="date"
                   value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="dateTo">Veröffentlicht bis</label>
            <input class="form-control" id="dateTo" name="dateTo" type="date"
                   value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="hashtag">Hashtag</label>
            <select class="form-select" id="hashtag" name="hashtag">
                <option value="">Alle Hashtags</option>
                @foreach (var hashtag in Model.AllHashtags)
                {
                    <option value="@hashtag.Slug" selected="@(Model.HashtagSlug == hashtag.Slug)">
                        #@hashtag.Name (@hashtag.Count)
                    </option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="sort">Sortierung</label>
            <select class="form-select" id="sort" name="sort">
                @foreach (var value in Enum.GetValues<ArticleSortOrder>())
                {
                    <option value="@value" selected="@(Model.Sort == value)">@SortDisplay.Label(value)</option>
                }
            </select>
        </div>
    </div>

    <div class="mv-filter__actions">
        <a class="btn btn-outline-secondary" asp-page="/Suche">Zurücksetzen</a>
        <button type="submit" class="btn btn-primary">Suchen</button>
    </div>
</form>

<p class="meta-mono mt-4 mb-3">
    @(Model.HasFilter ? $"{Model.TotalCount} Treffer" : "Alle Akten")
</p>

@if (Model.Articles.Count == 0)
{
    <p class="text-muted">Keine Akten gefunden. Bitte Suche oder Filter anpassen.</p>
}
else
{
    <div class="mv-cases">
        @foreach (var article in Model.Articles)
        {
            var image = Model.TitleImageUrl(article);
            <article class="mv-case">
                <div class="mv-case__head">
                    <span>ARCHIV @article.Category.ToString().ToUpperInvariant()</span>
                    <span class="text-end">#@article.Id.ToString("N").Substring(0, 8).ToUpperInvariant()</span>
                </div>
                @if (image is not null)
                {
                    <a class="mv-case__img" asp-page="/Articles/Details" asp-route-slug="@article.Slug">
                        <img src="@image" alt="@article.Title" loading="lazy" decoding="async" />
                    </a>
                }
                <div class="mv-case__body">
                    <h3 class="mv-case__title">
                        <a asp-page="/Articles/Details" asp-route-slug="@article.Slug">@article.Title</a>
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(article.Excerpt))
                    {
                        <p class="mv-case__excerpt">@article.Excerpt</p>
                    }
                    <div class="mv-case__meta">
                        <span class="mv-badge mv-badge--open">? OFFEN</span>
                        <span>@ArticleDisplay.AccessLabel(article.AccessLevel)</span>
                        <span>@article.PublishedAt?.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
                <div class="mv-case__footer">
                    <span>@(article.Author?.DisplayName ?? "Archiv")</span>
                    <a class="mv-case__next" asp-page="/Articles/Details" asp-route-slug="@article.Slug">WEITER &rarr;</a>
                </div>
            </article>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Seitennavigation">
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : null)">
                    <a class="page-link"
                       asp-page="/Suche"
                       asp-route-query="@Model.Query"
                       asp-route-category="@Model.Category"
                       asp-route-tag="@Model.TagSlug"
                       asp-route-hashtag="@Model.HashtagSlug"
                       asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                       asp-route-sort="@Model.Sort"
                       asp-route-pageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
