@using Microsoft.AspNetCore.Identity
@using BlogCms.Domain.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Mentalversagen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Oswald:wght@500;600;700&family=Special+Elite&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="importmap"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Zum Inhalt</a>

    <nav class="mv-navbar navbar-expand-lg" aria-label="Hauptnavigation">
        <div class="container d-flex flex-nowrap align-items-center gap-2">
            <a class="navbar-brand p-0" href="/" aria-label="Mentalversagen">
                <img src="/pics/Mentalversagen_schriftzug.png" alt="Mentalversagen" />
            </a>

            <button class="navbar-toggler border-0 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mv-nav"
                    aria-controls="mv-nav" aria-expanded="false" aria-label="Menü öffnen/schließen">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse flex-grow-1" id="mv-nav">
                @*
                    Die Hauptnavigation ist für alle Besucher identisch — unabhängig
                    von der Anmeldung. Rollenabhängige Funktionen liegen im
                    Benutzer-Dropdown rechts (siehe unten).
                *@
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Start</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Suche">Suche</a></li>
                    @if (FeatureConfig.Value.MonetizationEnabled)
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Membership/Index">Mitgliedschaft</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Donate/Index">Spenden</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-page="/Newsletter/Subscribe">Archivpost</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Konto";
                        <li class="nav-item dropdown mv-usermenu">
                            <button type="button"
                                    class="nav-link mv-usermenu__toggle"
                                    id="mv-usermenu-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <span class="mv-usermenu__name">@displayName</span>
                                @* Kleines, unauffälliges Symbol für das Dropdown. *@
                                <svg class="mv-usermenu__caret" viewBox="0 0 10 6" width="10" height="6"
                                     aria-hidden="true" focusable="false">
                                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor"
                                          stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end mv-usermenu__menu"
                                aria-labelledby="mv-usermenu-toggle">
                                <li><a class="dropdown-item" asp-page="/Account/Manage/Index">Mein Konto</a></li>
                                @if (User.IsInRole(nameof(BlogCms.Domain.Enums.UserRole.Author)) || User.IsInRole(nameof(BlogCms.Domain.Enums.UserRole.Admin)))
                                {
                                    <li><a class="dropdown-item" asp-page="/Admin/Articles/Index">Verwaltung</a></li>
                                }
                                @if (User.IsInRole(nameof(BlogCms.Domain.Enums.UserRole.Admin)))
                                {
                                    <li><a class="dropdown-item" asp-page="/Admin/LinkLists/Index">Kurieren</a></li>
                                }
                                @if (User.IsInRole(nameof(BlogCms.Domain.Enums.UserRole.Moderator)) || User.IsInRole(nameof(BlogCms.Domain.Enums.UserRole.Admin)))
                                {
                                    <li><a class="dropdown-item" asp-page="/Moderation/Index">Moderation</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout" class="m-0">
                                        <button type="submit" class="dropdown-item">Abmelden</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else if (FeatureConfig.Value.LoginEnabled)
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Anmelden</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Registrieren</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="mv-footer mt-5">
        <div class="container py-4">
            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <span>
                    <a asp-page="/Impressum">Impressum</a>
                    <span class="mx-2">·</span>
                    <a asp-page="/Datenschutz">Datenschutz</a>
                    <span class="mx-2">·</span>
                    <a href="/feed">RSS</a>
                    <span class="mx-2">·</span>
                    <span>&copy; @DateTime.UtcNow.Year</span>
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
