@model BlogCms.Web.Models.KiKennzeichnungModel
@*
    Kennzeichnung nach Artikel 50 Absatz 4 und 5 der KI-Verordnung.

    Bewusst als Symbol UND Text: nur Farbe oder nur ein Piktogramm wären nicht
    "klar und deutlich" im Sinne der Vorschrift und für Screenreader nicht
    lesbar. Das Symbol erbt die Textfarbe des umgebenden Bereichs (currentColor)
    und funktioniert damit auf dem dunklen Seitengrund wie auf dem Papier des
    Akten-Containers.
*@
<span class="mv-kennzeichnung" role="note">
    <svg class="mv-kennzeichnung__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5" />
        <g transform="translate(3.2 3.2) scale(0.4)">
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
        </g>
        <g transform="translate(11.2 11.2) scale(0.4)">
            <circle cx="12" cy="12" r="3.6" />
            <path d="M12 3.4v5.2M12 15.4v5.2M3.4 12h5.2M15.4 12h5.2" />
        </g>
    </svg>
    <span class="mv-kennzeichnung__text">@Model.Text</span>
    @if (Model.ShowLink)
    {
        <a class="mv-kennzeichnung__link" asp-page="/Hinweise" title="Hinweise zu Inhalten und Urheberschaft">Hinweise</a>
    }
</span>
