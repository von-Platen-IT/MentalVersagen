@model BlogCms.Web.Models.PageHeaderModel
@{
    var slide = Math.Clamp(Model.Slide, 1, 3);
}
<header class="page-header" style="--ph-img: url('/pics/header_slides_@(slide).png');">
    <div class="page-header__inner">
        <a class="page-header__logo" href="/" aria-label="Mentalversagen — Startseite">
            <img src="/pics/Mentalversagen_schriftzug.png" alt="Mentalversagen" />
        </a>
        <div class="page-header__text">
            @if (!string.IsNullOrEmpty(Model.Title))
            {
                <h1 class="page-header__title">@Model.Title</h1>
            }
            @if (!string.IsNullOrEmpty(Model.Sub))
            {
                <p class="page-header__sub">@Model.Sub</p>
            }
            @if (!string.IsNullOrEmpty(Model.Meta))
            {
                <p class="page-header__meta meta-mono">@Model.Meta</p>
            }
        </div>
    </div>
</header>
