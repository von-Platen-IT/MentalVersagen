@model BlogCms.Web.Models.ArticleCardModel
@using BlogCms.Web.Content
@{
    var article = Model.Article;
    var likes = article.Ratings.Count(r => r.Value == BlogCms.Domain.Enums.RatingValue.ThumbUp);
    var dislikes = article.Ratings.Count(r => r.Value == BlogCms.Domain.Enums.RatingValue.ThumbDown);

    // Stimmung des Beitrags: das Auge färbt sich grün bei überwiegendem
    // Daumen hoch, rot bei überwiegendem Daumen runter, sonst neutral.
    var viewsClass = likes > dislikes
        ? "mv-case__views--up"
        : dislikes > likes ? "mv-case__views--down" : "";
    var viewsTitle = likes > dislikes
        ? "Überwiegend positiv bewertet — Aufrufe dieses Beitrags"
        : dislikes > likes
            ? "Überwiegend negativ bewertet — Aufrufe dieses Beitrags"
            : "Aufrufe dieses Beitrags";
}
@*
    Einheitliche Rechercheakte-Karte. Wird von Startseite und Suche genutzt,
    damit das Markup nur an einer Stelle gepflegt wird. Die im site.js
    erzeugten Karten (renderCard) halten sich an exakt dieselben Klassen.
*@
<article class="mv-case">
    <div class="mv-case__head">
        <span>ARCHIV @CategoryDisplay.Label(article.Category).ToUpperInvariant()</span>
        <span class="text-end">#@article.Id.ToString("N").Substring(0, 8).ToUpperInvariant()</span>
    </div>
    @if (Model.ImageUrl is not null)
    {
        <a class="mv-case__img" asp-page="/Articles/Details" asp-route-slug="@article.Slug">
            <img src="@Model.ImageUrl" alt="@article.Title" loading="lazy" decoding="async" />
        </a>
    }
    <div class="mv-case__body">
        <h3 class="mv-case__title">
            <a asp-page="/Articles/Details" asp-route-slug="@article.Slug">@article.Title</a>
        </h3>
        @if (!string.IsNullOrWhiteSpace(article.Excerpt))
        {
            <p class="mv-case__excerpt">@article.Excerpt</p>
        }
        <div class="mv-case__meta">
            <span class="mv-badge mv-badge--open">? OFFEN</span>
            <span>@ArticleDisplay.AccessLabel(article.AccessLevel)</span>
            <span>@article.PublishedAt?.ToString("dd.MM.yyyy")</span>
        </div>
        <div class="mv-case__stats" title="Positive und negative Bewertungen">
            <span title="Positive Bewertungen">&#9650; @likes</span>
            <span title="Negative Bewertungen">&#9660; @dislikes</span>
        </div>
    </div>
    <div class="mv-case__footer">
        <span>@(article.Author?.DisplayName ?? "Archiv")</span>
        @* Ersetzt den "WEITER"-Link: die ganze Karte ist klickbar (siehe site.js),
           hier steht die Aufruf-Anzeige mit stimmungsabhängigem Auge. *@
        <span class="mv-case__views @viewsClass" title="@viewsTitle" aria-label="@viewsTitle">
            <svg class="mv-case__eye" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            @article.ViewCount
        </span>
    </div>
</article>