@model BlogCms.Domain.Enums.ArticleOrigin
@using BlogCms.Domain.Enums
@using BlogCms.Web.Content
@{
    var description = OriginDisplay.Description(Model);
    var modifier = OriginDisplay.Modifier(Model);
}
@*
    Kleines Ursprungs-Icon (Mensch / KI / Hybrid). Der Tooltip und das
    aria-label liefern den erklärenden Text beim Hover bzw. für Screenreader.
*@
<span class="mv-origin-badge mv-origin-badge--@modifier"
      title="@description" aria-label="@description" role="img">
    @if (Model == ArticleOrigin.Ai)
    {
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
            <rect x="4" y="7" width="16" height="12" rx="3" />
            <circle cx="9" cy="13" r="1.4" />
            <circle cx="15" cy="13" r="1.4" />
            <path d="M12 3v4M8 19v2M16 19v2" />
        </svg>
    }
    else if (Model == ArticleOrigin.Hybrid)
    {
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
            <circle cx="9" cy="8" r="3" />
            <path d="M3 20c0-3 3-5 6-5s6 2 6 5" />
            <path d="M18 4l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
        </svg>
    }
</span>
